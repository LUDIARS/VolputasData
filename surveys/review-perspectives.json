      "options": [
        { "value": "concise", "label": "良い点と注意点を短くまとめる" },
        { "value": "detailed", "label": "項目ごとに詳しく説明する" },
        { "value": "experience", "label": "自分の体験を中心に伝える" },
        { "value": "comparison", "label": "似た作品と比較して伝える" }
